# Copy to .env.local (gitignored, see root .gitignore) and fill in.
# All NEXT_PUBLIC_* values are public identifiers (not secrets) — Firebase's
# actual security boundary is server-side ID token verification
# (backend/app/auth.py), not keeping these hidden. Copy them from Firebase
# Console -> Project settings -> your web app -> SDK setup and config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The backend's URL. Defaults to http://localhost:8000 for local dev; set
# to the deployed Render URL in production (Vercel project settings).
# NEXT_PUBLIC_API_BASE_URL=
