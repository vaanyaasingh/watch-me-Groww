# Copy to .env and fill in as needed. .env is gitignored — never commit
# real values. Nothing here has a required value: every var defaults to
# the zero-setup mock/local behavior described in the root README.

# --- Market data (see app/providers/config.py) ---
# mock (default, zero network/credentials) | live | yfinance | amfi
MARKET_DATA_PROVIDER=mock

# --- News embeddings (see app/embeddings.py) ---
# mock (default, zero network/credentials) | gemini
EMBEDDING_PROVIDER=mock

# Gemini via Vertex AI (production path) — same GCP project as
# Cloud Run/Cloud SQL. Needs `gcloud auth application-default login` for
# local dev; a deployed Cloud Run service picks up its own service account
# instead and doesn't need this file at all.
GOOGLE_CLOUD_PROJECT=watch-me-groww
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini via a bare API key — local/non-GCP fallback only, ignored if
# GOOGLE_CLOUD_PROJECT is set. Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# --- Database (see app/db.py) ---
# Defaults to a local SQLite file if unset. Point at Cloud SQL Postgres in
# production, e.g. postgresql://user:pass@host:5432/dbname
# DATABASE_URL=
