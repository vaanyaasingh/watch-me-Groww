# Copy to .env and fill in as needed. .env is gitignored — never commit
# real values. Nothing here has a required value: every var defaults to
# the zero-setup mock/local behavior described in the root README.

# --- Market data (see app/providers/config.py) ---
# mock (default, zero network/credentials) | live | yfinance | amfi
MARKET_DATA_PROVIDER=mock

# --- News embeddings (see app/embeddings.py) ---
# mock (default, zero network/credentials) | gemini
EMBEDDING_PROVIDER=mock

# Gemini via Vertex AI — needs `gcloud auth application-default login` for
# Application Default Credentials, only available where that's set up
# (local dev, or a real GCP host like Cloud Run). This project is hosted on
# Render instead (not GCP), which has no ADC — use GEMINI_API_KEY there.
GOOGLE_CLOUD_PROJECT=watch-me-groww
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini via a bare API key — the path used in production (Render has no
# GCP ADC); also works locally. Ignored if GOOGLE_CLOUD_PROJECT is set, so
# leave that unset wherever this is used. Get one at
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# --- Database (see app/db.py) ---
# Defaults to a local SQLite file if unset. Point at a hosted Postgres in
# production (this project uses Neon's free tier), e.g.
# postgresql://user:pass@host/dbname?sslmode=require
# DATABASE_URL=

# --- Auth (see app/auth.py) ---
# The Firebase project id ID tokens are verified against. Defaults to
# GOOGLE_CLOUD_PROJECT (a Firebase project IS a GCP project) — only set
# this separately if they ever differ.
# FIREBASE_PROJECT_ID=

# --- CORS (see app/main.py) ---
# Comma-separated extra origins allowed to call this API, beyond
# http://localhost:3000 which is always allowed. Add the deployed Vercel
# URL here once it exists, e.g. https://smart-market-watchlist.vercel.app
# ALLOWED_ORIGINS=
